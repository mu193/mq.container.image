
ARG BASE_MQ_IMG

FROM ${BASE_MQ_IMG}

ARG RPMS
ARG FILES

ARG UID="1001"

USER 0

WORKDIR /home/mqm/

# podman 5.2.2 bug 

RUN mkdir -p /home/mqm ; echo "rpms=>${RPMS}< file=>${FILES}<"

ADD "${FILES}" .
#ADD files/ibm-img.tar.gz .

RUN  \
     microdnf --disableplugin=subscription-manager install -y ${RPMS}  \
  && microdnf --disableplugin=subscription-manager clean all           \
  && install /tools --directory --mode 2775                            \
  && install deploy/editrc        -m 440 -o ${UID} -g root -T /.editrc \
  && install deploy/amqsstopchild -m 750 -o ${UID} -g root -T /tools/amqsstopchild

USER ${UID}

